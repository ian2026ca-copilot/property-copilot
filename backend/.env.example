DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/property_copilot
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ANTHROPIC_API_KEY=your-anthropic-api-key
GEMINI_API_KEY=your-gemini-api-key
# SMTP for outgoing emails (password reset, welcome, overdue notices); if unset, emails are printed to the log instead
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
FROM_EMAIL=noreply@example.com
# Twilio for outgoing SMS (overdue notices); if unset, messages are printed to the log instead
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+15551234567
# DocuSign JWT Grant integration (see DocuSign Admin > Apps and Keys for these)
DOCUSIGN_INTEGRATION_KEY=your-docusign-integration-key
DOCUSIGN_ACCOUNT_ID=your-docusign-api-account-id
DOCUSIGN_USER_ID=your-docusign-api-username-guid
# PEM private key for the RSA keypair registered on the integration key; escape newlines as \n
DOCUSIGN_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# demo.docusign.net for sandbox, www.docusign.net for production
DOCUSIGN_BASE_PATH=https://demo.docusign.net/restapi
# account-d.docusign.com for sandbox, account.docusign.com for production
DOCUSIGN_AUTH_SERVER=account-d.docusign.com
